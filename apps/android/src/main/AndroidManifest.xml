<?xml version="1.0" encoding="utf-8"?>
<!--
  Songbird's Android host (D-0113). The same as what NSH packaging writes for Android for
  the app (permissions, the Rust flag, the files provider, the activity's flags), with
  Songbird's own activity in place of NSH's AppActivity, and the camera.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Scanning link and safety-number codes, photos and videos to send, video calls. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Calls and voice messages (D-0176): the microphone, and the audio route of a call. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Songbird works without a camera (tablets, Chromebooks): the screens say so. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Sharing where you are, once, when you ask (D-0174); never in the background. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <!-- Saving photos and videos on Android 8 and 9 (10+ uses MediaStore without it; D-0174). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:label="Songbird"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true">

        <meta-data android:name="com.longbridge.nsh.RUST" android:value="true" />

        <provider
            android:name="com.longbridge.nsh.FilesProvider"
            android:authorities="chat.songbird.app.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- UnifiedPush (D-0176): the user's distributor wakes Songbird; no Google services. -->
        <service
            android:name="chat.songbird.push.SongbirdPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name="chat.songbird.app.SongbirdActivity"
            android:exported="true"
            android:configChanges="locale|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|layoutDirection|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
